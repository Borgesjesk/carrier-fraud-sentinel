# Auto-detect text files
* text=auto eol=lf

# Java + JVM ecosystem
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.json text eol=lf

# Shell + Docker (Linux containers fail with CRLF)
*.sh text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Maven wrapper
mvnw text eol=lf
mvnw.cmd text eol=crlf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Environment templates (NO SECRETS)
.env.example text eol=lf
.env.template text eol=lf

# Binaries
*.jar binary
*.class binary
*.png binary
*.jpg binary
*.ico binary